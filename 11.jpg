    const resultBox = document.querySelector(".result-box-city");
    const resultBox_labour_law = document.querySelector(".result-box-city-labour-law");
    const resultBox_invoicesender = document.querySelector(".resultinvoicesender_boxcity");
    const resultBox_invoicereciever = document.querySelector(".resultinvoicereciever_boxcity");
    const resultBox_popup = document.querySelector(".result-box-city-popup");
    const resultBox_autopopup = document.querySelector(".result-box-city-autopopup");
    const inputBox = document.getElementById("input-box-city");
    const inputBox_labour_law = document.getElementById("input-box-city-labour-law");
    const inputBox_invoicesender = document.getElementById("inputinvoicesender_boxcity");
    const inputBox_invoicereciever = document.getElementById("inputinvoicereciever_boxcity");
    const inputBox_popup = document.getElementById("input-box-city-popup");
    const inputBox_autopopup = document.getElementById("input-box-city-autopopup");

    // Sanitize function to replace special characters
    function sanitizeText(text) {
        const specialChars = {
            'á': 'a',
            'Á': 'A',
            'à': 'a',
            'À': 'A',
            'ä': 'a',
            'Ä': 'A',
            'â': 'a',
            'Â': 'A',
            'ã': 'a',
            'Ã': 'A',
            'å': 'a',
            'Å': 'A',
            'ç': 'c',
            'Ç': 'C',
            'é': 'e',
            'É': 'E',
            'è': 'e',
            'È': 'E',
            'ë': 'e',
            'Ë': 'E',
            'ê': 'e',
            'Ê': 'E',
            'í': 'i',
            'Í': 'I',
            'ì': 'i',
            'Ì': 'I',
            'ï': 'i',
            'Ï': 'I',
            'î': 'i',
            'Î': 'I',
            'ñ': 'n',
            'Ñ': 'N',
            'ó': 'o',
            'Ó': 'O',
            'ò': 'o',
            'Ò': 'O',
            'ö': 'o',
            'Ö': 'O',
            'ô': 'o',
            'Ô': 'O',
            'õ': 'o',
            'Õ': 'O',
            'ú': 'u',
            'Ú': 'U',
            'ù': 'u',
            'Ù': 'U',
            'ü': 'u',
            'Ü': 'U',
            'û': 'u',
            'Û': 'U',
            'ß': 'ss',
            'ÿ': 'y',
            'Ÿ': 'Y'
        };
        return text.replace(/[^\w\s]/gi, char => specialChars[char] || '');
    }
    if (inputBox) {
        inputBox.onkeyup = function() {
            let result = [];
            let input = inputBox.value;
            if (input.length) {
                result = availableKeywords.filter(({
                    city
                }) => {
                    return city.toLowerCase().includes(input.toLowerCase());
                });
            }
            display(result);

        }
    }
    if (inputBox_labour_law) {
        inputBox_labour_law.onkeyup = function() {
            let result = [];
            let input = inputBox_labour_law.value;
            if (input.length) {
                result = availableKeywords.filter(({
                    city
                }) => {
                    return city.toLowerCase().includes(input.toLowerCase());
                });
            }
            display_labour_law(result);
        }
    }
