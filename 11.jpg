<!-- jQuery UI CSS CDN -->
<link href='https://code.jquery.com/ui/1.14.1/themes/ui-lightness/jquery-ui.css' rel='stylesheet'>

<!-- jQuery UI JS CDN -->
<script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js" defer>
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.8/js/select2.min.js" defer></script>

<script>
    $(document).ready(function() {

        document.querySelectorAll(".launchpadpopup").forEach(function(button) {
            button.addEventListener("click", function() {
                const modal = document.getElementById("launchpadModalform");
                modal.style.display = "flex";
            });
        });

        // // Close modal on click
        // document.querySelector(".close, .cancel-step").addEventListener("click", function() {
        //     document.getElementById("launchpadModalform").style.display = "none";
        // });


        document.querySelectorAll(".close, .cancel-step").forEach(function(btn) {
            btn.addEventListener("click", function() {
                document.getElementById("launchpadModalform").style.display = "none";
            });
        });


        // Video Item Hover + Play Logic
        $('.video-short-item').each(function() {

            const $item = $(this);
            const $image = $item.find('.video-short-item-image');
            const $video = $item.find('.video-short-item-video');
            const $absolute = $item.find('.video-short-absolute');
            const $playButton = $item.find('.play-button');
            const videoElement = $video[0];

            if (!videoElement) return;

            videoElement.muted = true;
            videoElement.pause();
            videoElement.preload = 'metadata';

            // Play Button Click
            $playButton.on('click', function(event) {
                event.stopPropagation();
                videoElement.muted = false;
                $image.hide();
                $video.show();
                $absolute.hide();
                $playButton.hide();

                videoElement.play().catch(function(error) {});
            });

            $video.on('mouseleave', function() {
                videoElement.pause();
                videoElement.currentTime = 0;
                $image.show();
                $video.hide();
                $absolute.show();
                $playButton.show();
            });
        });

        // Customer Slider
        $('.customer-content-slider').slick({
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: true,
            prevArrow: $('.customer-content-slider-arrows .left-arrow'),
            nextArrow: $('.customer-content-slider-arrows .right-arrow'),
            focusOnSelect: true
        });

        // Leaders Slider
        $('.leaders-testimonialtxt-slider').slick({
            slidesToShow: 1,
            slidesToScroll: 1,
            infinite: false,
            dots: false,
            arrows: true,
            prevArrow: $('.leaders-testimonialtxt-arrows .left-arrow'),
            nextArrow: $('.leaders-testimonialtxt-arrows .right-arrow'),
        });

        // guides slick slider(hr-resources)
        $('.guides-slick-slider').slick({
            slidesToShow: 3,
            slidesToScroll: 1,
            arrows: true,
            dots: false,
            autoplay: true,
            autoplaySpeed: 3000,
            responsive: [{
                breakpoint: 768,
                settings: {
                    slidesToShow: 2,
                    centerMode: true,
                    centerPadding: '30px',
                }
            }]
        });

        document.querySelectorAll('.floating-form-input-group').forEach(group => {
            const input = group.querySelector('input');

            group.addEventListener('click', () => {
                input.focus();
            });

            input.addEventListener('focus', () => {
                group.classList.add('is-focused');
            });

            input.addEventListener('blur', () => {
                group.classList.remove('is-focused');
            });
        });
    });
</script>

