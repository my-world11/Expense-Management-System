<script id="jquery-js-after">
window.$ = window.jQuery;
jQuery(document).ready(function($) {
        function initTocScroll() {
            $(document).off("click", ".hrone-toc-link");
            $(document).on("click", ".hrone-toc-link", function(e) {
                e.preventDefault();
                e.stopPropagation();
                var $link = $(this);
                var href = $link.attr("href") || $link.data("target") || "";
                var targetId = href.replace("#", "").trim();
                
                // Decode URL-encoded characters
                try {
                    targetId = decodeURIComponent(targetId);
                } catch(e) {
                    // If decoding fails, use as-is
                }
                
                if (!targetId) {
                    return false;
                }
                
                // Try native getElementById first (handles special characters better)
                var targetElement = null;
                var nativeEl = document.getElementById(targetId);
                
                // Also try with encoded version
                if (!nativeEl) {
                    try {
                        nativeEl = document.getElementById(encodeURIComponent(targetId));
                    } catch(e) {}
                }
                if (nativeEl) {
                    targetElement = $(nativeEl);
                } else {
                    // Try with CSS.escape if available (for special characters)
                    if (typeof CSS !== "undefined" && CSS.escape) {
                        try {
                            var escapedId = CSS.escape(targetId);
                            nativeEl = document.getElementById(escapedId);
                            if (!nativeEl) {
                                nativeEl = document.querySelector("#" + escapedId);
                            }
                            if (nativeEl) {
                                targetElement = $(nativeEl);
                            }
                        } catch(err) {}
                    }
                    
                    // Fallback: try jQuery with escaped selector
                    if (!targetElement || targetElement.length === 0) {
                        var escapedId = targetId.replace(/([!"#$%&'()*+,.\\/:;<=>?@[\\]^`{|}~])/g, "\\$1");
                        targetElement = $("#" + escapedId);
                    }
                    
                    // Try attribute selector
                    if (!targetElement || targetElement.length === 0) {
                        targetElement = $("[id=\"" + targetId.replace(/"/g, "\\"") + "\"]");
                    }
                    
                    // Try h2 specifically
                    if (!targetElement || targetElement.length === 0) {
                        targetElement = $("h2[id=\"" + targetId.replace(/"/g, "\\"") + "\"]");
                    }
                    
                    // Last resort: try querySelector
                    if (!targetElement || targetElement.length === 0) {
                        try {
                            nativeEl = document.querySelector("#" + targetId.replace(/:/g, "\:").replace(/\?/g, "\?"));
                            if (nativeEl) {
                                targetElement = $(nativeEl);
                            }
                        } catch(err) {}
                    }
                }
                
                if (targetElement && targetElement.length > 0) {
                    var offset = 100;
                    var targetPosition = targetElement.offset().top - offset;
                    $("html, body").stop(true, true).animate({
                        scrollTop: targetPosition
                    }, 800, "swing", function() {
                        if (history.pushState) {
                            history.pushState(null, null, "#" + targetId);
                        }
                    });
                    return false;
                } else {
                    // Final fallback: use native anchor behavior
                    try {
                        window.location.hash = targetId;
                    } catch(err) {
                        console.log("TOC: Could not scroll to target #" + targetId);
                    }
                    return false;
                }
            });
        }
        initTocScroll();
        $(document).on("ajaxComplete", function() {
            initTocScroll();
        });
    });
</script>
