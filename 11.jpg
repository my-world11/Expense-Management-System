    document.addEventListener('DOMContentLoaded', function() {
        const productSubmitBtn = document.getElementById('productSubmit');
        const ppcSubmit = document.getElementById('submitppc');
        if (productSubmitBtn) {
            productSubmitBtn.addEventListener('click', function() {
                const emailInput = document.getElementById('official_email');
                const emailValue = emailInput ? emailInput.value : '';
                dataLayer.push({
                    'event': 'formSubmitted',
                    'leadsUserData': {
                        'email': emailValue,
                    },
                });
            });
        }
        if (ppcSubmit) {
            ppcSubmit.addEventListener('click', function() {
                const emailInput = document.getElementById('ppc_email');
                const emailValue = emailInput ? emailInput.value : '';
                dataLayer.push({
                    'event': 'formSubmitted',
                    'leadsUserData': {
                        'email': emailValue,
                    },
                });
            });
        }
    });
