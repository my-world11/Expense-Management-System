        resultBox_autopopup.style.display = 'none';
    }

    function selectInput_invoicesender(list) {
        inputBox_invoicesender.value = list.getAttribute("data-city");
        const state = list.getAttribute("data-state");
        inputBox_invoicesender.setAttribute("data-state", state);
        inputBox_invoicesender.setAttribute("data-city", inputBox_invoicesender.value);
        resultBox_invoicesender.innerHTML = '';
        resultBox_invoicesender.style.display = 'none';
    }

    function selectInput_invoicereciever(list) {
        inputBox_invoicereciever.value = list.getAttribute("data-city");
        const state = list.getAttribute("data-state");
        inputBox_invoicereciever.setAttribute("data-state", state);
        inputBox_invoicereciever.setAttribute("data-city", inputBox_invoicereciever.value);
        resultBox_invoicereciever.innerHTML = '';
        resultBox_invoicereciever.style.display = 'none';
    }
    if (resultBox) {
        resultBox.addEventListener('click', function(event) {
            const listItem = event.target.closest('li[data-city]');
            if (!listItem || !resultBox.contains(listItem)) return;
            selectInput(listItem);
        });
    }
    if (resultBox_labour_law) {
        resultBox_labour_law.addEventListener('click', function(event) {
            const listItem = event.target.closest('li[data-city]');
            if (!listItem || !resultBox_labour_law.contains(listItem)) return;
            selectInput_labour_law(listItem);
        });
    }
    if (resultBox_popup) {
        resultBox_popup.addEventListener('click', function(event) {
            const listItem = event.target.closest('li[data-city]');
            if (!listItem || !resultBox_popup.contains(listItem)) return;
            selectInput_popup(listItem);
        });
    }
    if (resultBox_autopopup) {
        resultBox_autopopup.addEventListener('click', function(event) {
            const listItem = event.target.closest('li[data-city]');
            if (!listItem || !resultBox_autopopup.contains(listItem)) return;
            selectInput_autopopup(listItem);
        });
    }
    if (resultBox_invoicesender) {
        resultBox_invoicesender.addEventListener('click', function(event) {
            const listItem = event.target.closest('li[data-city]');
            if (!listItem || !resultBox_invoicesender.contains(listItem)) return;
            selectInput_invoicesender(listItem);
        });
    }
    if (resultBox_invoicereciever) {
        resultBox_invoicereciever.addEventListener('click', function(event) {
            const listItem = event.target.closest('li[data-city]');
            if (!listItem || !resultBox_invoicereciever.contains(listItem)) return;
            selectInput_invoicereciever(listItem);
        });
    }
    if (resultBox && inputBox) {
        // Hide result-box-city when clicking outside of it or the input box
        document.addEventListener('click', function(event) {
            if (!resultBox.contains(event.target) && !inputBox.contains(event.target)) {
                resultBox.style.display = 'none';
            }
        });
    }
    if (resultBox_labour_law && inputBox_labour_law) {
        document.addEventListener('click', function(event) {
            if (!resultBox_labour_law.contains(event.target) && !inputBox_labour_law.contains(event.target)) {
                resultBox_labour_law.style.display = 'none';
            }
        });
    }
    if (resultBox_popup && inputBox_popup) {
        document.addEventListener('click', function(event) {
            if (!resultBox_popup.contains(event.target) && !inputBox_popup.contains(event.target)) {
                resultBox_popup.style.display = 'none';
            }
        });
    }
    if (resultBox_autopopup && inputBox_autopopup) {
        document.addEventListener('click', function(event) {
            if (!resultBox_autopopup.contains(event.target) && !inputBox_autopopup.contains(event.target)) {
                resultBox_autopopup.style.display = 'none';
            }
        });
    }
    if (resultBox_invoicesender && inputBox_invoicesender) {
        document.addEventListener('click', function(event) {
            if (!resultBox_invoicesender.contains(event.target) && !inputBox_invoicesender.contains(event.target)) {
                resultBox_invoicesender.style.display = 'none';
            }
        });
    }
    if (resultBox_invoicereciever && inputBox_invoicereciever) {
        document.addEventListener('click', function(event) {
            if (!resultBox_invoicereciever.contains(event.target) && !inputBox_invoicereciever.contains(event.target)) {
                resultBox_invoicereciever.style.display = 'none';
            }
        });
    }
    // Show result-box-city when clicking on the input box
    if (inputBox) {
        inputBox.addEventListener('click', function() {
            if (resultBox.innerHTML !== '') {
                resultBox.style.display = 'block';
            }
        });
    }
    if (inputBox_labour_law) {
        inputBox_labour_law.addEventListener('click', function() {
            if (resultBox_labour_law.innerHTML !== '') {
                resultBox_labour_law.style.display = 'block';
            }
        });
    }
    if (inputBox_popup) {
        inputBox_popup.addEventListener('click', function() {
            if (resultBox_popup.innerHTML !== '') {
                resultBox_popup.style.display = 'block';
            }
        });
    }
    if (inputBox_autopopup) {
        inputBox_autopopup.addEventListener('click', function() {
            if (resultBox_autopopup.innerHTML !== '') {
                resultBox_autopopup.style.display = 'block';
            }
        });
    }
    if (inputBox_invoicesender) {
        inputBox_invoicesender.addEventListener('click', function() {
            if (resultBox_invoicesender.innerHTML !== '') {
                resultBox_invoicesender.style.display = 'block';
            }
        });
    }
    if (inputBox_invoicereciever) {
        inputBox_invoicereciever.addEventListener('click', function() {
            if (resultBox_invoicereciever.innerHTML !== '') {
                resultBox_invoicereciever.style.display = 'block';
            }
        });
    }
    // Propel / Webinar / Meetup forms are handled by assets/js/propel-form-submit.js

    // Product form submission is now handled by product-form-submit.js (frontend → HubSpot API)
    // Popup form submission is now handled by popup-form-submit.js
    // API keys are securely stored on server side in inc_functions/popup-form-handler.php
    $("#generate_descr").click(function(event) {
        event.preventDefault();

        const defaultLogoSrc = $('#complany_logo').attr('src');
        let isValid = true;
        let $form = $("#offerForm");

        $(".error").removeClass("error");

        // Required fields validation
        $form.find("[required]").each(function() {

            // Ignore hidden apply fields
            if ($(this).closest('[style*="display:none"]').length) {
                return true;
            }

            if ($(this).val().trim() === "") {
                $(this).addClass("error");
                isValid = false;
            }
        });

        // Experience validation
        let expMin = parseInt($("#experience_min").val()) || 0;
        let expMax = parseInt($("#experience_max").val()) || 0;

        if (expMax < expMin) {
            $("#experience_max").addClass("error");
            isValid = false;
        }

        // Salary validation
        let salaryMin = parseInt($("#Salary_min").val()) || 0;
        let salaryMax = parseInt($("#Salary_max").val()) || 0;

        if (salaryMax < salaryMin) {
            $("#Salary_max").addClass("error");
            isValid = false;
        }

        // Email validation
        if ($("#emailCheck").is(":checked")) {

            let email = $("#apply_email").val().trim();

            if (
                email === "" ||
                !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
            ) {
                $("#apply_email").addClass("error");
                isValid = false;
            }
        }

        // Mobile validation
        if ($("#mobileCheck").is(":checked")) {

            let mobile = $("#mobile").val().trim();

            if (!/^[0-9]{10}$/.test(mobile)) {
                $("#mobile").addClass("error");
                isValid = false;
            }
        }

        // Linkedin validation
        if ($("#linkedinCh").is(":checked")) {

            let linkedin = $("#linkedin_u").val().trim();

            if (linkedin === "") {
                $("#linkedin_u").addClass("error");
                isValid = false;
            }
        }

        // Other validation
        if ($("#other_chk").is(":checked")) {

            let other = $("#otherMethod").val().trim();

            if (other === "") {
                $("#otherMethod").addClass("error");
                isValid = false;
            }
        }

        if (!isValid) {

            $("html, body").animate({
                scrollTop: $(".error:first").offset().top - 120
            }, 300);

            return false;
        }

        let formId = $form.attr("id");
        let formData = captureFormData(formId);

        const hasData = Object.values(formData).some(
            value => value !== ""
        );

        if (!hasData) {
            return false;
        }

        let $btn = $("#generate_descr");

        $.ajax({

            url: hroneAjaxSecurity.ajax_url,

            type: "POST",

            data: {
                action: "generate_custom_job_description",
                form_data: formData,
                security: hroneAjaxSecurity.job_description
            },

            beforeSend: function() {

                $btn.prop("disabled", true);
                $btn.val("Generating...");
            },

            success: function(response) {

                $("#generatedResponse").html(response);
                $("#generated_desc_download").val(response);

                $(".job-download").show();
                $(".job-generate")
                    .removeClass("w-100")
                    .addClass("w-50");
            },

            error: function(xhr) {
                console.log(xhr.responseText);
                alert("Something went wrong while generating Job Description");
            },

            complete: function() {

                $btn.prop("disabled", false);
                $btn.val("Generate");
            }
        });

    });
</script>
<script>
    $ = jQuery;
    $(document).ready(function() {

        $(".button-popup2").click(function() {
            $(".home-banner-image2").addClass('hm-banner-img-animation2');
            $(".form-banner-popup2").addClass("form-popup-animation2");
            $(".banner-slider-container").addClass("form-banner-flex2")
            if ($(window).width() <= 660) {
                $(".banner-img-container").hide();
            }
        });

        $(".previous-button-banner2").click(function() {
            $(".home-banner-image2").removeClass('hm-banner-img-animation2');
            $(".form-banner-popup2").removeClass("form-popup-animation2");
            $(".banner-slider-container").removeClass("form-banner-flex2");
            if ($(window).width() <= 660) {
                $(".banner-img-container").show();
            }

        });
    });
</script>
<script>
    $ = jQuery;
    //---- select2 multiple----
    $(document).ready(function() {
        $('.floating-form-select2-select').each(function() {
            var dropdownParents = $(this).parents('.floating-form-select2');
            $(this).select2({
                dropdownParent: dropdownParents,
            }).on("select2:open", function(e) {
                $(this).parents('.floating-form-select2').addClass('focused');
            }).on("select2:close", function(e) {
                if ($(this).val() != '') {
                    $(this).parents('.floating-form-select2').addClass('focused');
                } else {
                    $(this).parents('.floating-form-select2').removeClass('focused');
                }
            }).on("select2:select", function(e) {
                $(this).parents('.floating-form-select2').addClass('focused');
            }).on("select2:unselect", function(e) {
                $(this).parents('.floating-form-select2').addClass('focused');
            })
        });
    });
</script>
<script>
    $ = jQuery;
    document.addEventListener("DOMContentLoaded", function() {
        const fileInput = document.getElementById('logo');
        if (!fileInput) return;
        const inputContainer = fileInput.closest('.floating-form-file');

        // Update label with custom name 'xyz' when a file is selected
        fileInput.addEventListener('change', function() {
            const fileName = this.files.length > 0 ? 'Image' : 'No file chosen'; // Always use 'xyz' as the file name
            inputContainer.setAttribute('data-file-name', fileName);

            if (fileName !== 'No file chosen') {
                inputContainer.classList.add('has-file');
            } else {
                inputContainer.classList.remove('has-file');
            }
        });

        // Add focus class on focus
        fileInput.addEventListener('focus', function() {
            inputContainer.classList.add('focused');
        });

        // Remove focus class on blur if no file is selected
        fileInput.addEventListener('blur', function() {
            inputContainer.classList.remove('focused');
        });
    });
</script>
<script>
    $ = jQuery;
    $(document).ready(function() {
        // $('#phone_ppc').keyup(function () {
        $('#phone_ppc').on('input', function() {
            var phoneNum = $('#phone_ppc').val();
            phoneNum = phoneNum.replace(/\D/g, '');
            // Ensure the phone number starts with 6, 7, 8, or 9
            if (/^[6-9]/.test(phoneNum)) {
                // Limit the phone number to 10 digits
                phoneNum = phoneNum.slice(0, 10);
                $('#phone_ppc').removeClass('error');
                $('.phone_error').html('');
            } else {
                // If the number doesn't start with 6, 7, 8, or 9, clear the input
                phoneNum = '';
                $('#phone_ppc').addClass('error');
                $('.phone_error').html('Insert valid number start from 6/7/8/9');

            }
            $('#phone_ppc').val(phoneNum);
        });
        $('#labour_law_phone').on('input', function() {
            var phoneNum = $('#labour_law_phone').val();
            phoneNum = phoneNum.replace(/\D/g, '');
            // Ensure the phone number starts with 6, 7, 8, or 9
            if (/^[6-9]/.test(phoneNum)) {
                // Limit the phone number to 10 digits
                phoneNum = phoneNum.slice(0, 10);
                $('#labour_law_phone').removeClass('error');
                $('.phone_error').html('');
            } else {
                // If the number doesn't start with 6, 7, 8, or 9, clear the input
                phoneNum = '';
                $('#labour_law_phone').addClass('error');
                $('.phone_error').html('Insert valid number start from 6/7/8/9');
            }
            $('#labour_law_phone').val(phoneNum);
        });

        var baseDomains = [];
        var baseDomainsLoaded = false; // Flag to track if base domains are loaded
        // Function to load the base domains from the file
        function loadBaseDomains_ppc() {
            var rootUrl = WPURLS.siteurl;
            var fileUrl = rootUrl + '/basedomain.txt';

            return $.get(fileUrl).then(function(data) {
                baseDomains = data.split('\n').map(function(domain) {
                    return domain.trim().toLowerCase();
                });
                baseDomainsLoaded = true;
            }).fail(function() {
                //console.error('Failed to load base domains file.');
            });
        }
        loadBaseDomains_ppc();
        // Function to validate the email
        function validateEmail(email) {
            var atIndex = email.indexOf('@');
            var dotIndex = email.lastIndexOf('.');
            if (atIndex === -1 || dotIndex === -1 || atIndex > dotIndex) {
                // $('#official_email').addClass('error');
                // $('.email_error').html('Invalid email format.');
                isValid = false;
                return false;
            }

            var domain = email.slice(atIndex + 1).toLowerCase();

            // List of accepted TLDs
            var acceptedTLDs = [
                'com', 'shop', 'life', 'us', 'ai', 'biz', 'name', 'in', 'ca', 'co.in', 'net', 'org', 'edu', 'ac.in',
                'one', 'online', 'cloud', 'tech', 'co', 'info', 'world', 'io', 'com.au', 'au', 'eu',

                // Additional commonly used TLDs
                'me', 'app', 'dev', 'xyz', 'site', 'store', 'digital', 'media', 'live', 'news', 'club',
                'space', 'agency', 'solutions', 'website', 'tools', 'software', 'design', 'academy', 'cafe', 'care', 'bike', 'bio',

                // Additional ccTLDs and second-level ccTLDs
                'uk', 'co.uk', 'org.uk', 'gov.uk', 'nz', 'de', 'fr', 'it', 'es', 'nl', 'ch', 'jp', 'kr', 'cn',
                'gov.in', 'org.in', 'net.au', 'org.au'
            ];

            if (
                email.trim() === '' ||
                isNotAcceptedDomain(domain) ||
                !validateDomainStructure(domain, acceptedTLDs) ||
                email.includes('..')
            ) {
                return false;
            } else {
                return true;
            }
        }

        function isNotAcceptedDomain(domain) {
            return baseDomains.some(function(baseDomain) {
                // Check if the domain starts with or matches the base domain
                var domainParts = domain.split('.');
                return domainParts[0] === baseDomain;
            });
        }

        function validateDomainStructure(domain, acceptedTLDs) {
            // Regular expression to validate the domain structure
            var domainRegex = /^[a-z0-9.-]+\.[a-z]{2,}$/;
            if (!domainRegex.test(domain) || domain.includes('..')) {
                return false;
            }
            // Check if TLD is in the accepted list
            var tld = domain.split('.').pop();
            return acceptedTLDs.indexOf(tld) !== -1;
        }
        $("#submitlaunchpad").click(function() {
            event.preventDefault();
            var state = $('#input-box-city-popup').attr('data-state');
            var isValid = true;
            var email = $('#launchpad_email').val();
            var phoneNum = $('#phone_launchpad').val();
            if (!baseDomainsLoaded) {
                $('.email_error').html('Please wait while the email domains are being loaded. Try again.');
                isValid = false;
            }
            $(this).parent().find("input[type='text'], input[type='email']").each(function() {
                if ($(this).val().trim() === '') {
                    isValid = false;
                    $(this).addClass('error');
                } else {
                    $(this).removeClass('error');
                }
                var phoneNum = $('#phone_launchpad').val();
                var phoneRegex = /^[6-9]\d{9}$/;
                if (!phoneRegex.test(phoneNum)) {
                    $('#phone_launchpad').addClass('error');
                    $('.phone_error_launchpad').html('Insert a valid number ');
                    isValid = false;
                } else {
                    $('#phone_launchpad').removeClass('error');
                    $('.popup_phone_error').html('');
                }
            });
            if (email.length > 0) {
                var email = $('#launchpad_email_popup').val().trim().toLowerCase();
                if (!validateEmail(email)) {
                    $('#launchpad_email_popup').addClass('error');
                    $('.email_error').html('Please insert valid work email. ');
                    isValid = false;
                } else {
                    $('.email_error').html('');
                }
            }

            function validateCity() {
                const inputCity = inputBox_popup.value.trim();
                const cityExists = availableKeywords.some(({
                    city
                }) => city === inputCity);
                if (!cityExists) {
                    $('.city-error').html('City not found in the list. Please select a valid city.');
                    //alert("City not found in the list. Please select a valid city.");
                    return false;
                } else {
                    $('.city-error').html('');
                }
                return true;
            }
            if (!validateCity()) {
                isValid = false;
                event.preventDefault();
            }

            var formId = $(this).closest("form").attr("id");
            var form = document.getElementById(formId);
            var no_of_employee_exists = form.querySelector('#no_of_employee') !== null;
            if (no_of_employee_exists) {

                var no_of_employee_field = $('#no_of_employee');
                if (no_of_employee_field.length > 0) {
                    var no_of_employee = no_of_employee_field.val();
                    if (!no_of_employee) {
                        isValid = false;
                        no_of_employee_field.addClass('error');
                        $('.employee_error').html('Please select the number of employees.');
                    } else {
                        no_of_employee_field.removeClass('error');
                        $('.employee_error').html('');
                    }
                }
            }
            // If any field is empty, prevent proceeding to the next step
            if (!isValid) {

                return false;
            }
            const formData = captureFormData(formId);
            formData.state_code = state;
            const isEmpty = Object.values(formData).some(value => value !== '');
            if (isEmpty) {
                document.getElementById("submitlaunchpad").disabled = true;
                $.ajax({
                    url: 'https://hrone.cloud/wp-admin/admin-ajax.php',
                    type: 'POST',
                    data: {
                        action: 'submit_product_launchpad',
                        form_data: formData,
                        security: hroneAjaxSecurity.launchpad_form
                    },
                    success: function(response) {
                        $('#launchpadform')[0]?.reset();
                        document.getElementById("submitlaunchpad").disabled = false;
                        window.location.href = "https://hrone.cloud/thankyou";
                        $('.launchpad-form-popup').html(response);
                    }
                });

            }
        });
        $("#submitlaunchpadMob").click(function() {
            event.preventDefault();
            var state = $('#input-box-city').attr('data-state');
            var isValid = true;
            var email = $('#launchpad_email_popup').val();
            var phoneNum = $('#phone_launchpad_mob').val();
            if (!baseDomainsLoaded) {
                $('.email_error').html('Please wait while the email domains are being loaded. Try again.');
                isValid = false;
            }
            $(this).parent().find("input[type='text'], input[type='email']").each(function() {
                if ($(this).val().trim() === '') {
                    isValid = false;
                    $(this).addClass('error');
                } else {
                    $(this).removeClass('error');
                }
                var phoneNum = $('#phone_launchpad_mob').val();
                var phoneRegex = /^[6-9]\d{9}$/;
                if (!phoneRegex.test(phoneNum)) {
                    $('#phone_launchpad_mob').addClass('error');
                    $('.phone_error_launchpad').html('Insert a valid number ');
                    isValid = false;
                } else {
                    $('#phone_launchpad_mob').removeClass('error');
                    $('.popup_phone_error').html('');
                }
            });
            if (email.length > 0) {
                console.log('email', email);
                console.log('validateEmail', validateEmail(email));
                var email = $('#launchpad_email_popup').val().trim().toLowerCase();
                if (!validateEmail(email)) {
                    $('#launchpad_email_popup').addClass('error');
                    $('.email_error').html('Please insert valid work email. ');
                    isValid = false;
                } else {
                    $('.email_error').html('');
                }
            }

            function validateCity() {
                const inputCity = inputBox.value.trim();
                const cityExists = availableKeywords.some(({
                    city
                }) => city === inputCity);
                if (!cityExists) {
                    $('.city-error').html('City not found in the list. Please select a valid city.');
                    //alert("City not found in the list. Please select a valid city.");
                    return false;
                } else {
                    $('.city-error').html('');
                }
                return true;
            }
            if (!validateCity()) {
                isValid = false;
                event.preventDefault();
            }
            var formId = $(this).closest("form").attr("id");
            var form = document.getElementById(formId);
            var no_of_employee_exists = form.querySelector('#no_of_employee_mob') !== null;
            if (no_of_employee_exists) {
                var no_of_employee_field = $('#no_of_employee_mob');
                if (no_of_employee_field.length > 0) {
                    var no_of_employee = no_of_employee_field.val();
                    if (!no_of_employee) {
                        isValid = false;
                        no_of_employee_field.addClass('error');
                        $('.employee_error').html('Please select the number of employees.');
                    } else {
                        no_of_employee_field.removeClass('error');
                        $('.employee_error').html('');
                    }
                }
            }
            // If any field is empty, prevent proceeding to the next step
            if (!isValid) {

                return false;
            }
            const formData = captureFormData(formId);
            console.log('formData', formData);
            formData.state_code = state;
            const isEmpty = Object.values(formData).some(value => value !== '');
            if (isEmpty) {
                document.getElementById("submitlaunchpadMob").disabled = true;
                $.ajax({
                    url: 'https://hrone.cloud/wp-admin/admin-ajax.php',
                    type: 'POST',
                    data: {
                        action: 'submit_product_launchpad_mob',
                        form_data: formData,
                        security: hroneAjaxSecurity.launchpad_mob
                    },
                    success: function(response) {
                        $('#launchpadformpopup')[0]?.reset();
                        document.getElementById("submitlaunchpadMob").disabled = false;
                        window.location.href = "https://hrone.cloud/thankyou";
                        $('.launchpad-form').html(response);
                    }
                });
            }
        });
    });
    // Function to save user data
    function saveUserDataLanding() {
        var formData = captureFormData();
        isValidemail = true;
        // var utm_source = getUrlParameter('utm_source');
        var utm_medium = getUrlParameter('utm_medium');
        var utm_campaign = getUrlParameter('utm_campaign');
        var state = $('#input-box-city').attr('data-state');
        formData.state_code = state;
        // formData.utm_source = utm_source;
        formData.utm_medium = utm_medium;
        formData.utm_campaign = utm_campaign;
        var email = $('#ppc_email').val();
        if (!validateEmail(email)) {
            formData.ppc_email = '';
            isValidemail = false;
        }
        if (!isValidemail) {
            return false;
        }
    }
    window.addEventListener('beforeunload', saveUserDataLanding);


    window.onload = function() {

        if (sessionStorage.getItem("popupShown")) return;

        setTimeout(function() {

            var popup = document.getElementById("loadpopup");
            if (!popup) return;

            popup.style.display = "block";
            document.body.classList.add("scroll-hidden");
            sessionStorage.setItem("popupShown", "true");

        }, 20000);
    };

    // Close button
    var closePopupBtn = document.getElementById("close-popup");
    if (closePopupBtn) {
        closePopupBtn.onclick = function() {
            var popup = document.getElementById("loadpopup");
            if (popup) popup.style.display = "none";
            document.body.classList.remove("scroll-hidden");
        };
    }

    // Click outside popup
    window.addEventListener("click", function(event) {
        var popup = document.getElementById("loadpopup");
        if (popup && event.target === popup) {
            popup.style.display = "none";
            document.body.classList.remove("scroll-hidden");
        }
    });

    // Copy to clipboard
    function CopyToClipboard(containerid) {

        var element = document.getElementById(containerid);
        if (!element) return;

        var selection = window.getSelection();
        var range = document.createRange();

        selection.removeAllRanges();
        range.selectNodeContents(element);
        selection.addRange(range);

        try {
            document.execCommand("copy");
            if (window.jQuery) {
                $('.copymsg').html('Text has been copied');
            }
        } catch (e) {}

        selection.removeAllRanges();
    }


    $(window).bind('scroll', function() {
        if ($(window).scrollTop() > 600) {
            $('.scrolling-navbar').addClass('scrolling-fixed');
            $('.lp-page-logos').css({
                'display': 'block'
            });
        } else {
            $('.scrolling-navbar').removeClass('scrolling-fixed');
            $('.lp-page-logos').css({
                'display': 'none'
            });
        }
    });

    $(document).ready(function() {
        $('.plus-more-popup, .plus-more-mobile').on('click', function(event) {
            event.stopPropagation();
            $('.more-product').toggle();
        });
        $(document).on('click', function(event) {
            if (!$(event.target).closest('.more-product').length && !$(event.target).closest('.plus-more-popup, plus-more-mobile').length) {
                $('.more-product').hide();
            }
        });
    });
</script>
