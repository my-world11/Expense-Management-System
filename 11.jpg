<script>
    $ = jQuery;

    function getQueryParam(param) {
        var urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(param);
    }
    document.querySelector('input[name="utm_source"]').value = getQueryParam('utm_source');
    document.querySelector('input[name="utm_medium"]').value = getQueryParam('utm_medium');
    document.querySelector('input[name="utm_campaign"]').value = getQueryParam('utm_campaign');
    document.querySelector('input[name="utm_content"]').value = getQueryParam('utm_content');
    document.querySelector('input[name="utm_term"]').value = getQueryParam('utm_term');

    document.querySelector('.utm_source').value = getQueryParam('utm_source');
    document.querySelector('.utm_medium').value = getQueryParam('utm_medium');
    document.querySelector('.utm_campaign').value = getQueryParam('utm_campaign');
    document.querySelector('.utm_content').value = getQueryParam('utm_content');
    document.querySelector('.utm_term').value = getQueryParam('utm_term');


    var getUrlParameter = function getUrlParameter(sParam) {
        var sPageURL = window.location.search.substring(1),
            sURLVariables = sPageURL.split('&'),
            sParameterName,
            i;
        for (i = 0; i < sURLVariables.length; i++) {
            sParameterName = sURLVariables[i].split('=');

            if (sParameterName[0] === sParam) {
                return sParameterName[1] === undefined ? true : decodeURIComponent(sParameterName[1]);
            }
        }
        return false;
    };
    $(document).ready(function() {
        // $("input").keyup(function() {
        //     var inputId = $(this).attr("id");
        //     var val = $(this).val();
        //     $("." + inputId.replace('_', '')).text(val);
        //     console.log("." + inputId.replace('_', ''));

        // });

        $("input, select, textarea").on("input change", function() {
            if ($(this).attr("type") === "file") {
                return;
            }
            var inputId = $(this).attr("id");
            var val = $(this).val();
            $("." + inputId.replace(/_/g, '')).text(val);
        });

        $("#invoice_notes, #invoice_termcondi").keyup(function() {
            var inputId = $(this).attr("id");
            var inputdataName = $(this).attr("data-name");
            var val = $(this).val();

            if (inputId === 'invoice_notes') {
                if (val.trim() !== "") {
                    $('.notehead').text(inputdataName);
                } else {
                    $('.notehead').text('');
                }
            }

            if (inputId === 'invoice_termcondi') {
                if (val.trim() !== "") {
                    $('.termhead').text(inputdataName);
                } else {
                    $('.termhead').text('');
                }
            }
            const bullet = "\u2022";

            var bulletList = val.split('\n').map(function(line) {
                return line.trim() + '<br>';
            }).join('');

            if (bulletList.endsWith('<br>')) {
                bulletList = bulletList.slice(0, -4);
            }

            $("." + inputId.replace('_', '')).html(bulletList);
        });

        $("select").change(function() {
            var selectId = $(this).attr("id");
            var val = $(this).val();
            $("." + selectId.replace('_', '')).text(val);
            //console.log("." + selectId.replace('_', ''));
        });
        $("#pay_date").change(function() {
            var val = $(this).val();
            if (val) {
                var date = new Date(val + "-01");
                var monthName = date.toLocaleString("default", {
                    month: "short"
                }).toUpperCase();
                var year = date.getFullYear().toString().slice(-2);
                $(".paydate").text(monthName + year);
            }
        });

        $(".datepicker").datepicker({
            onSelect: function() {
                var inputId = $(this).attr("id");
                //console.log(inputId.replace('_', ''));
                $("." + inputId.replace('_', '')).text($(this).val());
            }
        });
        $('#doc_required').select2({
            closeOnSelect: false,
            placeholder: "Select Documents Required for Joining",
            allowHtml: true,
            allowClear: true,
            tags: true,
        });
        $(document).on("change", '#doc_required', function() {
            $('#list-old').empty();
            var ul = $('<ul></ul>');
            $("#doc_required option:selected").each(function() {
                var doc_name = $(this).attr('data-name');
                ul.append('<li>' + doc_name + '</li>');
            });
            $('#list-old').append(ul);
        });
        // $("#submitbtn").click(function() {
        //     $("#customModal").fadeIn();
        // });

        //blog page 
        var current_fs, next_fs, previous_fs; //fieldsets
        var left, opacity, scale;
        var animating;

        var baseDomains = [];
        var baseDomainsLoaded = false; // Flag to track if base domains are loaded
        // Function to load the base domains from the file
        function loadBaseDomains() {
            var rootUrl = WPURLS.siteurl;
            var fileUrl = rootUrl + '/basedomain.txt';

            return $.get(fileUrl).then(function(data) {
                baseDomains = data.split('\n').map(function(domain) {
                    return domain.trim().toLowerCase();
                });
                //console.log('Base domains:', baseDomains);
                baseDomainsLoaded = true;
                $(".next-step").prop("disabled", false);
            }).fail(function() {
                //console.error('Failed to load base domains file.');
            });
        }
        loadBaseDomains();
        // Function to validate the email
        function validateEmail(email) {
            var atIndex = email.indexOf('@');
            var dotIndex = email.lastIndexOf('.');
            if (atIndex === -1 || dotIndex === -1 || atIndex > dotIndex) {
                isValid = false;
                return false;
            }

            var domain = email.slice(atIndex + 1).toLowerCase();

            // List of accepted TLDs
            var acceptedTLDs = [
                'com', 'shop', 'life', 'us', 'ai', 'biz', 'name', 'in', 'ca', 'co.in', 'net', 'org', 'edu', 'ac.in',
                'one', 'online', 'cloud', 'tech', 'co', 'info', 'world', 'io', 'com.au', 'au', 'eu',

                // Additional commonly used TLDs
                'me', 'app', 'dev', 'xyz', 'site', 'store', 'digital', 'media', 'live', 'news', 'club',
                'space', 'agency', 'solutions', 'website', 'tools', 'software', 'design', 'academy', 'cafe', 'care', 'bike', 'bio',


                'uk', 'co.uk', 'org.uk', 'gov.uk', 'nz', 'de', 'fr', 'it', 'es', 'nl', 'ch', 'jp', 'kr', 'cn',
                'gov.in', 'org.in', 'net.au', 'org.au'
            ];

            if (
                email.trim() === '' ||
                isNotAcceptedDomain(domain) ||
                !validateDomainStructure(domain, acceptedTLDs) ||
                email.includes('..')
            ) {

                $('#official_email').addClass('error');
                $('.email_error').html('Please enter a valid work email.');
                return false;
            } else {
                $('#official_email').removeClass('error');
                $('.email_error').html('');
                return true;
            }
        }

        function isNotAcceptedDomain(domain) {
            return baseDomains.some(function(baseDomain) {
                // Check if the domain starts with or matches the base domain
                var domainParts = domain.split('.');
                return domainParts[0] === baseDomain;
            });
        }

        function validateDomainStructure(domain, acceptedTLDs) {
            var domainRegex = /^[a-z0-9.-]+\.[a-z]{2,}$/;
            if (!domainRegex.test(domain) || domain.includes('..')) {
                return false;
            }
            var tld = domain.split('.').pop();
            return acceptedTLDs.indexOf(tld) !== -1;
        }

        $(".next-blog").click(function() {
            var isValid = true;
            animating = true;

            current_fs = $(this).parent();
            next_fs = $(this).parent().next();

            current_fs.find("input[type='text'], input[type='email']").each(function() {

                if ($(this).val().trim() === '') {
                    isValid = false;
                    $(this).addClass('error');

                } else {
                    $(this).removeClass('error');
                }
            });
            if (current_fs.find("#email").length > 0) {

                var email = $('#email').val().trim().toLowerCase();

                if (!validateEmail(email)) {
                    //console.log(isValid);
                    isValid = false;
                    $(this).removeClass('error');
                    $('#email').addClass('error');
                } else {
                    $(this).removeClass('error');
                }
            }
            loadBaseDomains().then(function() {
                $(".next-blog").prop("disabled", false);
            });
            var mobNum = $('#phone').val();
            var filter = /^\d*(?:\.\d{1,2})?$/;
            if (filter.test(mobNum)) {
                if (mobNum.length != 10) {
                    $('#phone').val('');

                    $('#phone').addClass('error');
                    isValid = false;
                } else {
                    $('#phone').removeClass('error');
                }
            } else {
                $('#phone').val('');
                $('#phone').addClass('error');
                isValid = false;

            }
            if (!isValid) {
                return false;
            }
            if (isValid) {
                $(".progressbar li").eq($("fieldset").index(next_fs)).addClass("active");
                next_fs.show();
                current_fs.animate({
                    opacity: 0
                }, {
                    step: function(now, mx) {
                        scale = 1 - (1 - now) * 0.2;
                        left = (now * 50) + "%";
                        opacity = 1 - now;
                        current_fs.css({
                            'transform': 'scale(' + scale + ')',

                        });
                        next_fs.css({
                            'left': left,
                            'opacity': opacity
                        });
                    },
                    duration: 500,
                    complete: function() {
                        current_fs.hide();
                        animating = false;
                    },
                    easing: 'easeInOutBack'
                });
            }
        });
        $(".previous").click(function() {
            if (animating) return false;
            animating = true;

            current_fs = $(this).parent();
            previous_fs = $(this).parent().prev();

            $(".progressbar li").eq($("fieldset").index(current_fs)).removeClass("active");

            previous_fs.show();
            current_fs.animate({
                opacity: 0
            }, {
                step: function(now, mx) {
                    scale = 0.8 + (1 - now) * 0.2;
                    left = ((1 - now) * 50) + "%";
                    opacity = 1 - now;
                    current_fs.css({
                        'left': left
                    });
                    previous_fs.css({
                        'transform': 'scale(' + scale + ')',
                        'opacity': opacity
                    });
                },
                duration: 500,
                complete: function() {
                    current_fs.hide();
                    animating = false;
                },
                //this comes from the custom easing plugin
                easing: 'easeInOutBack'
            });
        });
    });
    $(".submit").click(function() {
        return false;
    });
</script>
<script>
    var baseDomains = [];
    var baseDomainsLoaded = false; // Flag to track if base domains are loaded
    // Function to load the base domains from the file
    function loadBaseDomains() {
        var rootUrl = WPURLS.siteurl;
        var fileUrl = rootUrl + '/basedomain.txt';

        return $.get(fileUrl).then(function(data) {
            baseDomains = data.split('\n').map(function(domain) {
                return domain.trim().toLowerCase();
            });
            baseDomainsLoaded = true;
        }).fail(function() {});
    }
    loadBaseDomains();
    // Function to validate the email
    function validateEmail(email) {
        if (email) {
            var atIndex = email.indexOf('@');
            var dotIndex = email.lastIndexOf('.');
            if (atIndex === -1 || dotIndex === -1 || atIndex > dotIndex) {
                isValid = false;
                return false;
            }

            var domain = email.slice(atIndex + 1).toLowerCase();
            // List of accepted TLDs
            var acceptedTLDs = [
                'com', 'shop', 'life', 'us', 'ai', 'biz', 'name', 'in', 'ca', 'co.in', 'net', 'org', 'edu', 'ac.in',
                'one', 'online', 'cloud', 'tech', 'co', 'info', 'world', 'io', 'com.au', 'au', 'eu',

                // Additional commonly used TLDs
                'me', 'app', 'dev', 'xyz', 'site', 'store', 'digital', 'media', 'live', 'news', 'club',
                'space', 'agency', 'solutions', 'website', 'tools', 'software', 'design', 'academy', 'cafe', 'care', 'bike', 'bio',

                // Additional ccTLDs and second-level ccTLDs
                'uk', 'co.uk', 'org.uk', 'gov.uk', 'nz', 'de', 'fr', 'it', 'es', 'nl', 'ch', 'jp', 'kr', 'cn',
                'gov.in', 'org.in', 'net.au', 'org.au'
            ];

            if (
                email.trim() === '' ||
                isNotAcceptedDomain(domain) ||
                !validateDomainStructure(domain, acceptedTLDs) ||
                email.includes('..')
            ) {

                $('#official_email').addClass('error');
                $('.email_error').html('Please enter a valid work email.');
                return false;
            } else {
                $('#official_email').removeClass('error');
                $('.email_error').html('');
                return true;
            }
        }
    }

    function isNotAcceptedDomain(domain) {
        return baseDomains.some(function(baseDomain) {
            // Check if the domain starts with or matches the base domain
            var domainParts = domain.split('.');
            return domainParts[0] === baseDomain;
        });
    }

    function validateDomainStructure(domain, acceptedTLDs) {
        // Regular expression to validate the domain structure
        var domainRegex = /^[a-z0-9.-]+\.[a-z]{2,}$/;
        if (!domainRegex.test(domain) || domain.includes('..')) {
            return false;
        }
        // Check if TLD is in the accepted list
        var tld = domain.split('.').pop();
        return acceptedTLDs.indexOf(tld) !== -1;
    }
    $(".button-popup").click(function(event) {
        isValidemail = true;
        var email = $('#official_email').val().trim().toLowerCase();
        if (email.length > 0 || !email) {
            if (!validateEmail(email)) {
                isValidemail = false;
                $('#official_email').addClass('error');
            } else {
                $(this).removeClass('error');
            }
        }

        if (!isValidemail) {
            return false;
        }
        $(".banner-img-container").addClass('hm-banner-img-animation');
        $(".banner-single-input").hide();
        $(".form-banner-popup").addClass("form-popup-animation");
        $(".banner-slider-container").addClass("form-banner-flex");

        if ($(window).width() <= 660) {
            $(".banner-slider-content").hide();
        }
    });

    $(".previous-button-banner").click(function() {
        $(".banner-img-container").removeClass('hm-banner-img-animation');
        $(".banner-single-input").show();
        $(".form-banner-popup").removeClass("form-popup-animation");
        $(".banner-slider-container").removeClass("form-banner-flex");
        if ($(window).width() <= 660) {
            $(".banner-slider-content").show();
        }
    });

    // new two

    jQuery(document).ready(function($) {
        $('.download-form').on('click', function(event) {

            console.log("click")
            event.preventDefault();

            var $btn = $(this);
            // Prevent double click / duplicate load
            // if ($btn.data('loading')) return;
            // $btn.data('loading', true);


            // Get page_id safely
            var page_id = $btn.attr('data-page_id');
            if (!page_id) {
                page_id = $('[data-page_id]').first().data('page_id') || '';
                if (page_id) {
                    $btn.attr('data-page_id', page_id);
                }
            }

            var $overlay = $('.download-form-overlay');
            var $container = $overlay.find('.formoverlay-inner-container .form-container');

            if (!$container.length) {
                console.error('Form container not found');
                $btn.data('loading', false);
                return;
            }

            // Clear old form if exists
            $container.empty();

            // Create HubSpot form script
            var script = document.createElement('script');
            var inlineScript = document.createTextNode(`
            hbspt.forms.create({
            region: "na1",
            portalId: "7277696",
            formId: "43e7d2bc-687a-4672-bb0d-cd6afafe811b",
            target: document.querySelector(".formoverlay-inner-container .form-container"),
            onFormSubmit: function () {
                window.open('${WPURLS.siteurl}/thank-you/?download_id=${page_id}');
                setTimeout(function () {
                    $(".form-container").empty();
                    $('body').removeClass('scroll-hidden');
                    $('.download-form-overlay').fadeOut();
                    $btn.data('loading', false);
                }, 100);
            }
            });
            `);

            script.appendChild(inlineScript);
            $container[0].appendChild(script);

            // Show overlay & lock scroll
            $overlay.fadeIn();
            $('body').addClass('scroll-hidden');

        });
        $(".popnew").click(function(event) {
            event.preventDefault();
            $('.popnewform').fadeIn();
        });
        $('.close-formoverlay-btnnw').click(function() {

            $('.popnewform, .download-form-overlay').fadeOut();
            $("#popupForm")[0]?.reset();
            $('.form-container').empty();
            $('.download-form').each(function() {
                $(this).data('loading', false);
            });
            $('body').removeClass('scroll-hidden');

        });
    });


    // On form submit
    $("#launchpad-formemail").on("submit", function(e) {
        e.preventDefault();

        var isValidEmail = true;
        var email = $('#launchpad_email').val().trim().toLowerCase();
        var clickedBtn = $(document.activeElement); // detect which button was clicked

        // Email validation check
        if (!email || !validateEmail(email)) {
            isValidEmail = false;
            $('#launchpad_email').addClass('is-invalid');
            $(".email_error").text('Please enter a valid work email.');
            $(".launchpad_email_popup").val('');
        } else {
            $('#launchpad_email').removeClass('is-invalid');
            $(".email_error").text('');
        }

        if (isValidEmail) {
            // Common success actions
            $("#launchpad_email").removeClass("is-invalid");
            $(".email_error").text('');
            $(".launchpad_email_popup").val(email);

            if (clickedBtn.hasClass("mobile-btn")) {
                // ✅ Mobile → scroll only
                $('html, body').animate({
                    scrollTop: $("#launchpad-formemail").offset().top
                }, 600);
                $('#launchpad_email').focus();
            } else {
                // ✅ Desktop → open popup
                this.reset();
                $("#launchpadModalform").css("display", "flex");
            }
        }
        return false; // safety
    });

    $("#homeBannerForm").on("submit", function(e) {
        e.preventDefault();
        var isValidEmail = true;
        var email = $('#workEmailbanner').val().trim().toLowerCase();
        var clickedBtn = $(document.activeElement); // detect which button was clicked

        // Email validation check
        if (!email || !validateEmail(email)) {
            isValidEmail = false;
            $('#workEmailbanner').addClass('is-invalid');
            $(".email_errorbanner").text('Please enter a valid work email.');
            $(".popup_official_email").val('');
        } else {
            $('#workEmailbanner').removeClass('is-invalid');
            $(".email_errorbanner").text('');
        }
        if (isValidEmail) {
            // Common success actions
            $("#workEmailbanner").removeClass("is-invalid");
            $(".email_errorbanner").text('');
            $(".popup_official_email").val(email);

            if (clickedBtn.hasClass("mobile-btn")) {
                // ✅ Mobile → scroll only
                $('html, body').animate({
                    scrollTop: $("#launchpad-formemail").offset().top
                }, 600);
                $('#launchpad_email').focus();
            } else {
                // ✅ Desktop → open popup
                this.reset();
                $("#popnewform").css("display", "flex");
            }
        }
        return false; // safety
    });

    $(".close, .cancel-step").on("click", function() {
        $("#launchpadModalform").css("display", "none");
        $("#launchpadform")[0]?.reset();
        $("#launchpadform .is-invalid").removeClass("is-invalid");
        $("#launchpadform .email_error").text('');
    })
</script>
<script>
    $ = jQuery;

    function captureFormData(formId = null) {
        const formData = {};
        let inputs;
        if (formId) {
            // Select inputs from the specific form by ID
            inputs = document.querySelectorAll(`#${formId} input[type="text"], #${formId} input[type="email"], #${formId} input[type="number"], #${formId} input[type="radio"]:checked, #${formId} input[type="checkbox"]:checked, #${formId} select, #${formId} textarea`);
        } else {
            // Select inputs from all forms if no formId is provided
            inputs = document.querySelectorAll('form input[type="text"], form input[type="email"], form input[type="radio"]:checked, form input[type="checkbox"]:checked, form select, form textarea');
        }
        inputs.forEach(input => {
            formData[input.name] = input.value;
        });
        return formData;
    }

    function captureFormData_msformBlog() {
        const formDataBlog = {};
        const inputs = document.querySelectorAll('#msformBlog input[type="text"], #msformBlog input[type="email"], #msformBlog select');
        inputs.forEach(input => {
            formDataBlog[input.name] = input.value;
        });
        return formDataBlog;
    }
    // Capture form submission event
    $('#phone_nu').on('input', function() {
        var phoneNum = $(this).val();
        // Remove non-numeric characters
        phoneNum = phoneNum.replace(/\D/g, '');
        // Ensure the phone number starts with 6, 7, 8, or 9
        if (/^[6-9]/.test(phoneNum)) {
            // Limit the phone number to 10 digits
            phoneNum = phoneNum.slice(0, 10);
            $(this).removeClass('error');
            $('.phone_error').html('');
        } else {
            // If the number doesn't start with 6, 7, 8, or 9, clear the input
            phoneNum = '';
            $(this).addClass('error');
            $('.phone_error').html('Insert valid number start from 6/7/8/9');

        }
        // Update the input value
        $(this).val(phoneNum);
    });

