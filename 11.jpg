    function selectInput(list) {
        inputBox.value = list.getAttribute("data-city");
        const state = list.getAttribute("data-state");
        inputBox.setAttribute("data-state", state);
        resultBox.innerHTML = '';
        resultBox.style.display = 'none';
    }

    function selectInput_labour_law(list) {
        inputBox_labour_law.value = list.getAttribute("data-city");
        const state = list.getAttribute("data-state");
        inputBox_labour_law.setAttribute("data-state", state);
        resultBox_labour_law.innerHTML = '';
        resultBox_labour_law.style.display = 'none';
    }

    function selectInput_popup(list) {
        inputBox_popup.value = list.getAttribute("data-city");
        const state = list.getAttribute("data-state");
        inputBox_popup.setAttribute("data-state", state);
