    function display(result) {
        const content = result.map(({
            city,
            state,
            state_code,
            country
        }) => {
            return `<li data-city="${city}" data-state="${state_code}" data-country="IN">${city}, ${state}, ${country}</li>`;
        });
        resultBox.innerHTML = "<ul>" + content.join('') + "</ul>";
        resultBox.style.display = result.length ? 'block' : 'none';
    }

    function display_labour_law(result) {
        const content = result.map(({
            city,
            state,
            state_code,
            country
        }) => {
            return `<li data-city="${city}" data-state="${state_code}" data-country="IN">${city}, ${state}, ${country}</li>`;
        });
        resultBox_labour_law.innerHTML = "<ul>" + content.join('') + "</ul>";
        resultBox_labour_law.style.display = result.length ? 'block' : 'none';
    }

